---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import ProgressDashboard from "@/components/dashboard/ProgressDashboard";
import { createClient } from "@/lib/supabase";
import { listSessions } from "@/lib/db/sessions";

export const prerender = false;

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
// Middleware guards /dashboard, so `user` is present; guard anyway for types/config.
const sessions = supabase && user ? await listSessions(supabase, user.id) : [];
---

<Layout title="Dashboard">
  <main class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <h1 class="mb-1 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Your progress
        </h1>
        <p class="mb-6 text-sm text-blue-100/70">Your score over time for each exam you've practiced.</p>
        <ProgressDashboard sessions={sessions} client:load />
      </div>
    </div>
  </main>
</Layout>
