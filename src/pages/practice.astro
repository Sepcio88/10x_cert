---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import PracticeGenerator from "@/components/practice/PracticeGenerator";
---

<Layout title="Practice">
  <main class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <h1 class="mb-1 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Practice questions
        </h1>
        <p class="mb-6 text-sm text-blue-100/70">
          Pick a cloud provider and exam, choose how many questions, and generate a fresh practice set.
        </p>
        <PracticeGenerator client:load />
      </div>
    </div>
  </main>
</Layout>
